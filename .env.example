# Настройки приложения
ARES_ENV=development
ARES_BIND_ADDRESS=127.0.0.1
ARES_PORT=8001

# DeepSeek (LLM); ключ понадобится при подключении API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Провайдеры STT/TTS ещё не выбраны; переменные пока общие заполнители.
STT_PROVIDER=unconfigured
STT_API_KEY=
TTS_PROVIDER=unconfigured
TTS_API_KEY=
